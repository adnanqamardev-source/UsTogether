rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything not explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function isAuthenticated() {
      return isSignedIn();
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    // True if request.auth.uid is a member of the couple at /couples/{coupleId}
    function isCoupleMember(coupleId) {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/couples/$(coupleId)).data.user1Id == request.auth.uid ||
         get(/databases/$(database)/documents/couples/$(coupleId)).data.user2Id == request.auth.uid);
    }

    // ------------------------------------------------------------
    // 1. Users — PII isolation
    // ------------------------------------------------------------
    match /users/{userId} {
      function isOwner() {
        return isAuthenticated() && request.auth.uid == userId;
      }

      allow get: if isOwner();
      allow list: if false; // never list users

      allow create: if isOwner() && isValidId(userId) &&
        request.resource.data.keys().hasAll(['email', 'points', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().size() >= 4 && request.resource.data.keys().size() <= 6 &&
        request.resource.data.email is string &&
        request.resource.data.points is number && request.resource.data.points >= 0 &&
        request.resource.data.createdAt is number &&
        request.resource.data.updatedAt is number;

      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['displayName', 'pairedCoupleId', 'points', 'updatedAt']);
    }

    // ------------------------------------------------------------
    // 2. Pairing codes
    // ------------------------------------------------------------
    match /pairingCodes/{code} {
      // Users may create/read their own code; reads allow lookup during pairing.
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['userId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.createdAt is number;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if false;
    }

    // ------------------------------------------------------------
    // 3. Couples + subcollections
    // ------------------------------------------------------------
    match /couples/{coupleId} {
      function isMember() {
        return isAuthenticated() &&
          (resource.data.user1Id == request.auth.uid || resource.data.user2Id == request.auth.uid);
      }
      function isIncomingMember() {
        return isAuthenticated() &&
          (request.resource.data.user1Id == request.auth.uid ||
           request.resource.data.user2Id == request.auth.uid);
      }

      allow get: if isMember();
      allow list: if false; // no blanket listing

      allow create: if isIncomingMember() && isValidId(coupleId) &&
        request.resource.data.keys().hasAll(
          ['user1Id', 'user2Id', 'status', 'totalScore', 'createdAt', 'updatedAt']) &&
        request.resource.data.user1Id is string &&
        request.resource.data.user2Id is string &&
        request.resource.data.status in ['pending', 'active'] &&
        request.resource.data.totalScore is number && request.resource.data.totalScore >= 0 &&
        request.resource.data.createdAt is number &&
        request.resource.data.updatedAt is number;

      allow update: if isMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['status', 'coupleName', 'totalScore', 'updatedAt']) &&
        request.resource.data.user1Id == resource.data.user1Id &&
        request.resource.data.user2Id == resource.data.user2Id &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.updatedAt is number;

      // Members may delete their couple to fully disconnect (unpair).
      // Subcollections become unreachable once the parent is gone
      // (isCoupleMember get() fails → access denied), which is the intended
      // privacy posture after disconnect.
      allow delete: if isMember();

      // ---- 3.1 Couple messages (members only) ----
      match /messages/{messageId} {
        allow get: if isCoupleMember(coupleId);
        allow list: if isCoupleMember(coupleId);
        allow create: if isCoupleMember(coupleId) && isValidId(messageId) &&
          request.resource.data.keys().hasAll(['senderId', 'text', 'timestamp']) &&
          request.resource.data.keys().size() == 3 &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId is string &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
          request.resource.data.timestamp is timestamp;
        allow update: if false;
        allow delete: if false;
      }

      // ---- 3.2 Couple sessions (members only) ----
      match /sessions/{sessionId} {
        function isValidSession(data) {
          return data.keys().hasAll(['coupleId', 'type', 'status', 'state', 'createdAt', 'updatedAt']) &&
            data.keys().size() == 6 &&
            data.coupleId is string && data.coupleId == coupleId &&
            data.type in ['quiz', 'minigame'] &&
            data.status in ['waiting', 'playing', 'finished'] &&
            data.state is map &&
            data.createdAt is number &&
            data.updatedAt is number;
        }

        allow get: if isCoupleMember(coupleId);
        allow list: if isCoupleMember(coupleId);

        allow create: if isCoupleMember(coupleId) && isValidId(sessionId) &&
          isValidSession(request.resource.data) &&
          request.resource.data.createdAt - request.time.toMillis() < 60000;

        allow update: if isCoupleMember(coupleId) &&
          resource.data.status != 'finished' && // terminal state
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'state', 'updatedAt']) &&
          request.resource.data.coupleId == resource.data.coupleId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if false; // handled by the couple doc deletion path
      }
    }

    // ------------------------------------------------------------
    // 4. Quizzes (community, created by users)
    // ------------------------------------------------------------
    match /quizzes/{quizId} {
      // Public quizzes are readable by any authenticated user.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();

      allow create: if isAuthenticated() && isValidId(quizId) &&
        request.resource.data.keys().hasAll(
          ['creatorId', 'title', 'description', 'questions', 'isPublic', 'createdAt']) &&
        request.resource.data.keys().size() == 6 &&
        request.resource.data.creatorId == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.description is string &&
        request.resource.data.questions is list && request.resource.data.questions.size() <= 50 &&
        request.resource.data.isPublic is bool &&
        request.resource.data.createdAt is number;

      allow update: if isAuthenticated() &&
        resource.data.creatorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['title', 'description', 'questions', 'isPublic']) &&
        request.resource.data.creatorId == resource.data.creatorId &&
        request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isAuthenticated() && resource.data.creatorId == request.auth.uid;
    }
  }
}
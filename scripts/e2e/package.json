{
  "name": "e2e-test-runner",
  "version": "1.0.0",
  "description": "Utilities for running E2E tests and generating reports",
  "main": "generate-report.js",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=html,list,json",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:repeat": "playwright test --repeat-each=10",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "private": true,
  "type": "module"
}

{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "chrome-devtools-mcp@latest", "--headless"],
      "enabled": true
    },
    "mcp-apps": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/ext-apps"],
      "enabled": false
    },
    "mcp-ui": {
      "type": "local",
      "command": ["npx", "-y", "@mcp-ui/server"],
      "enabled": false
    },
    "mcp-proxy": {
      "type": "local",
      "command": ["npx", "-y", "mcp-proxy"],
      "enabled": false
    },
    "mcp-use": {
      "type": "local",
      "command": ["npx", "-y", "mcp-use"],
      "enabled": false
    },
    "inspector": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/inspector"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "plugin": ["ecc-universal"]
}
